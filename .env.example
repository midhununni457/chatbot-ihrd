# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model configuration
MODEL_PROVIDER=gemini  # Options: gemini, local, huggingface
MODEL_NAME=models/gemini-1.5-flash-latest  # For local models, use the path to the model file

# Path to local LLM model file
MODEL_PATH=models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf

# Model performance settings
# Uncomment to use GPU if available
# LLAMA_CPP_GPU_LAYERS=1000

# Minimum threads to use for inference
# Set this to the number of CPU cores in your system
# LLAMA_THREADS=4
